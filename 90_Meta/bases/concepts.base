name: Concepts Log
folder: 50_Concepts
views:
  - type: table
    name: All Concepts
    sort: []
    columns:
      - title
      - domain
      - difficulty
      - prerequisite
  - type: table
    name: Beginner Concepts
    filter: difficulty == 'beginner'
    columns:
      - title
      - domain
      - prerequisite
