{
  "name": "Concepts Log",
  "folder": "50_Concepts",
  "views": [
    {
      "name": "All Concepts",
      "type": "table",
      "sort": [
        { "field": "title", "direction": "asc" }
      ],
      "columns": ["title", "domain", "difficulty", "prerequisite"]
    },
    {
      "name": "Beginner Concepts",
      "type": "table",
      "filter": "difficulty == 'beginner'",
      "columns": ["title", "domain", "prerequisite"]
    }
  ]
}
