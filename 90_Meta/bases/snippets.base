name: Code Snippets
folder: 40_Snippets
views:
  - type: table
    name: All Snippets
    sort: []
    columns:
      - title
      - lib
      - language
      - version
      - verified
  - type: table
    name: Unverified Snippets
    filter: verified == false
    columns:
      - title
      - lib
      - language
      - created
