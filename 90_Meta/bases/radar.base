name: Technology Radar
folder: 10_Libraries
views:
  - type: table
    name: All Libraries
    sort: []
    columns:
      - lib
      - ecosystem
      - version
      - verdict
      - confidence
      - used_in
  - type: table
    name: Adopted Stack
    filter: verdict == 'adopt'
    columns:
      - lib
      - ecosystem
      - version
      - confidence
      - used_in
  - type: table
    name: To Assess
    filter: verdict == 'assess' || verdict == 'trial'
    columns:
      - lib
      - ecosystem
      - verdict
      - confidence
      - created
