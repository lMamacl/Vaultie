{
  "name": "Architecture Decisions Log",
  "folder": "30_Decisions",
  "views": [
    {
      "name": "All Decisions",
      "type": "table",
      "sort": [
        { "field": "created", "direction": "desc" }
      ],
      "columns": ["title", "status", "affects", "supersedes", "created"]
    },
    {
      "name": "Proposed",
      "type": "table",
      "filter": "status == 'proposed'",
      "columns": ["title", "affects", "created"]
    }
  ]
}
