name: Architecture Decisions Log
folder: 30_Decisions
views:
  - type: table
    name: All Decisions
    sort: []
    columns:
      - title
      - status
      - affects
      - supersedes
      - created
  - type: table
    name: Proposed
    filter: status == 'proposed'
    columns:
      - title
      - affects
      - created
