name: Inbox Triage & Clips
folder: 00_Inbox
views:
  - type: table
    name: Clips Triage
    sort: []
    columns:
      - title
      - topic
      - relevance
      - source
      - retrieved
  - type: table
    name: High Relevance Clips
    filter: relevance >= 4
    columns:
      - title
      - topic
      - relevance
      - source
